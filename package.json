{
  "name": "@mjakl/pi-git-research",
  "version": "2.0.0",
  "description": "Tools for researching and exploring Git repositories with Pi agent",
  "type": "module",
  "main": "src/index.ts",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "keywords": [
    "pi",
    "pi-package",
    "git",
    "research",
    "clone",
    "summary"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mjakl/pi-git-research.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  }
}
